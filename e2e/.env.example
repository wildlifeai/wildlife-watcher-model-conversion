# Copy to e2e/.env and fill in. Specs skip themselves when their vars are absent.

# Frontend under test: local vite dev server or the deployed dev site
E2E_BASE_URL=http://localhost:5173
# FastAPI backend: local Docker (:8000) or the Azure dev container app
E2E_API_URL=http://localhost:8000

# Seeded test user (dev DB): see scripts/build_seed_fixtures.py / seed docs
E2E_EMAIL=tui@ww.org
E2E_PASSWORD=

# For the LoRaWAN realtime spec only (inserts + deletes synthetic telemetry).
# Dev project ONLY — never point this at production.
E2E_SUPABASE_URL=
E2E_SUPABASE_SERVICE_ROLE_KEY=
# Override if the seed deployment UUID differs
# E2E_LORAWAN_DEPLOYMENT_ID=e0000000-0000-0000-0000-000000000010
